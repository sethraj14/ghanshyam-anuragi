---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import Timeline from "../components/Timeline.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import VideoGrid from "../components/VideoGrid.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Icon from "../components/Icon.astro";
import Lotus from "../components/Lotus.astro";
import { person, contact, biography, rasoi, facts, leaders, homeVideos, galleryList, mediaList } from "../data/site";
import hero from "../assets/bio-1.png";
import portraitBio from "../assets/portrait-bio.png";
import rasoiPhoto from "../assets/rasoi_6.jpg";

const gallery = import.meta.glob<ImageMetadata>("../assets/gallery/*.jpg", { eager: true, import: "default" });
const media = import.meta.glob<ImageMetadata>("../assets/media/*.jpg", { eager: true, import: "default" });
const pick = (list: { src: string }[], all: Record<string, ImageMetadata>, n: number) =>
  list.slice(0, n).map((p) => all[`../assets${p.src.replace("/images", "")}`]).filter(Boolean);
---

<Base sky>
  <section class="relative mx-auto max-w-6xl px-4 pt-6 sm:pt-14 grid gap-2 sm:gap-6 sm:grid-cols-2 sm:items-end">
    <div class="relative order-first sm:order-last justify-self-center flex items-end justify-center">
      <span class="bloom parallax-slow absolute top-0 left-1/2 -translate-x-1/2 aspect-square w-64 sm:w-sm lg:w-lg rounded-full bg-gradient-to-b from-saffron/45 via-gold/30 to-transparent ring-1 ring-saffron/25" aria-hidden="true"></span>
      <span class="absolute bottom-3 left-1/2 -translate-x-1/2 h-3 w-28 sm:h-5 sm:w-56 rounded-full bg-ink/20 blur-sm sm:blur-md" aria-hidden="true"></span>
      <Image
        src={hero}
        alt={person.name}
        widths={[360, 560, 900]}
        sizes="(min-width: 1024px) 28rem, (min-width: 640px) 40vw, 70vw"
        loading="eager"
        fetchpriority="high"
        class="rise parallax relative w-56 sm:w-sm lg:w-md h-auto"
      />
    </div>
    <div class="text-center sm:text-left pb-8 sm:pb-24">
      <p class="rise inline-flex items-center gap-2 rounded-full bg-white/60 border border-saffron/30 pl-1.5 pr-4 py-1 font-semibold text-saffron-deep"><Lotus size={28} />{person.party}</p>
      <h1 class="rise rise-2 mt-4 text-4xl sm:text-5xl lg:text-7xl font-extrabold text-ink">{person.name}</h1>
      <p class="rise rise-3 mt-3 text-xl sm:text-2xl font-display font-bold text-saffron-deep">{person.roles[0]}</p>
      <p class="rise rise-3 text-xl sm:text-2xl font-display font-bold text-ink">{person.roles[1]}</p>
      <div class="rise rise-4 mt-7 flex flex-wrap justify-center sm:justify-start gap-3">
        <a href={contact.phoneHref} class="inline-flex items-center h-12 px-6 rounded-full bg-saffron text-white font-semibold text-lg shadow-lg shadow-saffron/30">फ़ोन करें</a>
        <a href="/about" class="inline-flex items-center h-12 px-6 rounded-full border-2 border-ink/15 bg-white/60 font-semibold text-lg">जीवनी पढ़ें</a>
      </div>
    </div>
  </section>

  <section class="border-y border-saffron/20 bg-white/50">
    <dl class="stagger mx-auto max-w-6xl px-4 py-5 grid grid-cols-3 divide-x divide-saffron/20 text-center">
      {facts.map((f) => (
        <div class="px-2">
          <dd class="font-display font-extrabold text-xl sm:text-4xl text-saffron-deep whitespace-nowrap" data-count={f.count} data-suffix={f.suffix}>{f.value}</dd>
          <dt class="mt-1 text-sm sm:text-base text-ink-2 leading-snug">{f.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 py-12 sm:py-16 grid gap-8 sm:grid-cols-[280px_1fr] sm:items-start">
    <div class="justify-self-center sm:justify-self-start">
      <div class="w-48 sm:w-full aspect-[4/5] rounded-t-full rounded-b-3xl overflow-hidden bg-saffron/15 ring-1 ring-saffron/25">
        <Image src={portraitBio} alt="" widths={[280, 560]} sizes="280px" class="w-full h-full object-cover object-top" />
      </div>
    </div>
    <div class="max-w-2xl">
      <h2 class="text-3xl sm:text-4xl font-extrabold">{biography[0][0]}</h2>
      <p class="mt-5 text-xl sm:text-2xl leading-relaxed font-display text-ink">{biography[1][0].split("।")[0]}।</p>
      <p class="mt-4 text-lg leading-relaxed text-ink-2">{biography[1][0].split("।").slice(1).join("।").trim()}</p>
      <a href="/about" class="inline-flex items-center h-11 mt-6 px-5 rounded-full bg-ink text-paper font-semibold">पूरी जीवनी पढ़ें</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <SectionHead title="नेतृत्व के साथ" icon="people" href="/gallery" />
    <div class="stagger grid gap-3 grid-cols-2 lg:grid-cols-3">
      {leaders.map((l) => (
        <figure class="lift rounded-2xl overflow-hidden bg-paper-2 border border-ink/10">
          <Image src={gallery[`../assets/gallery/gallery_${l.photo}.jpg`]} alt={l.caption} widths={[400, 800]} sizes="(min-width: 1024px) 33vw, 50vw" quality={65} class="w-full aspect-[4/3] object-cover" />
          <figcaption class="px-3 py-2 text-sm sm:text-base leading-snug text-ink-2">{l.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10">
    <SectionHead title="राजनीतिक यात्रा" icon="flag" />
    <Timeline />
  </section>

  <section class="reveal mx-auto max-w-6xl px-4 py-10">
    <a href="/apni-rasoi" class="lift grid gap-0 sm:grid-cols-2 rounded-3xl overflow-hidden bg-ink text-paper">
      <Image src={rasoiPhoto} alt="अपनी रसोई में भोजन" widths={[480, 960]} sizes="(min-width: 640px) 50vw, 100vw" class="w-full h-full object-cover aspect-[4/3] sm:aspect-auto" />
      <div class="p-6 sm:p-10 flex flex-col justify-center">
        <p class="font-display font-bold text-2xl sm:text-3xl leading-snug">{rasoi.slogan[0]}<br />{rasoi.slogan[1]}</p>
        <p class="mt-4 text-paper/80 text-lg">अपनी रसोई: भारत जन सेवा फाउंडेशन के माध्यम से प्रतिदिन 800 से 900 लोगों को ₹5 में भरपेट भोजन।</p>
        <span class="mt-5 inline-flex items-center gap-2 text-gold font-semibold"><Icon name="food" />अपनी रसोई के बारे में</span>
      </div>
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <SectionHead title="तस्वीरें" icon="camera" href="/gallery" />
    <div class="stagger grid grid-cols-2 sm:grid-cols-4 gap-3">
      {pick(galleryList, gallery, 5).map((img, i) => (
        <a href={img.src} aria-label="तस्वीर बड़ी देखें" data-photo
          class:list={["lift block rounded-2xl overflow-hidden bg-paper-2", i === 0 && "col-span-2 row-span-2"]}>
          <Image src={img} alt="" widths={[360, 640, 900]} sizes={i === 0 ? "(min-width: 640px) 50vw, 100vw" : "(min-width: 640px) 25vw, 50vw"} quality={65}
            class="w-full h-full object-cover aspect-square" />
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <SectionHead title="वीडियो" icon="play" href="/videos" />
    <VideoGrid ids={homeVideos} />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <SectionHead title="मीडिया में" icon="news" href="/media" />
    <PhotoGrid images={pick(mediaList, media, 3)} columns="columns-1 sm:columns-3" />
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <SectionHead title="संपर्क" icon="phone" />
    <ContactBlock />
  </section>
</Base>
