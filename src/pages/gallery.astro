---
import Base from "../layouts/Base.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { galleryList } from "../data/site";

const all = import.meta.glob<ImageMetadata>("../assets/gallery/*.jpg", { eager: true, import: "default" });
const images = galleryList.map((p) => all[`../assets${p.src.replace("/images", "")}`]).filter(Boolean);
---

<Base title="तस्वीरें">
  <section class="mx-auto max-w-6xl px-4 pt-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-6">तस्वीरें</h1>
    <PhotoGrid images={images} eager={6} />
  </section>
</Base>
