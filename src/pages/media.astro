---
import Base from "../layouts/Base.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { mediaList } from "../data/site";

const all = import.meta.glob<ImageMetadata>("../assets/media/*.jpg", { eager: true, import: "default" });
const images = mediaList.map((p) => all[`../assets${p.src.replace("/images", "")}`]).filter(Boolean);
---

<Base title="मीडिया में">
  <section class="mx-auto max-w-6xl px-4 pt-8">
    <h1 class="text-3xl sm:text-4xl font-extrabold mb-2">मीडिया में</h1>
    <p class="text-ink-2 mb-6">अख़बारों में छपी ख़बरें और कतरनें।</p>
    <PhotoGrid images={images} columns="columns-1 sm:columns-2 lg:columns-3" eager={3} />
  </section>
</Base>
