---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { rasoi } from "../data/site";

const photos = Object.values(
  import.meta.glob<ImageMetadata>("../assets/rasoi_*.jpg", { eager: true, import: "default" })
);
---

<Base title="अपनी रसोई" sky>
  <article class="mx-auto max-w-6xl px-4 pt-8 pb-12">
    <header class="max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight">{rasoi.slogan[0]}<br />{rasoi.slogan[1]}</h1>
      <blockquote class="mt-8 border-l-4 border-gold pl-5 font-display text-xl text-ink-2">
        {rasoi.shloka.map((l) => <p>{l}</p>)}
      </blockquote>
    </header>

    <div class="mt-10 grid gap-3 grid-cols-2 sm:grid-cols-3">
      {photos.map((img, i) => (
        <Image src={img} alt="अपनी रसोई" widths={[400, 800]} sizes="(min-width: 640px) 33vw, 50vw" loading={i < 2 ? "eager" : "lazy"}
          class:list={["w-full h-full object-cover rounded-2xl aspect-[4/3]", i === 0 && "col-span-2 sm:col-span-1"]} />
      ))}
    </div>

    <div class="prose-hi max-w-3xl mt-10 text-lg leading-relaxed">
      {rasoi.paras.map((p) => p.map((l) => <p>{l}</p>))}
    </div>
  </article>
</Base>
