---
import Base from "../layouts/Base.astro";
import ContactBlock from "../components/ContactBlock.astro";
import Social from "../components/Social.astro";
import { socials } from "../data/site";
---

<Base title="संपर्क" sky>
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-12">
    <h1 class="text-4xl sm:text-5xl font-extrabold mb-8">संपर्क</h1>
    <ContactBlock />
    <h2 class="text-2xl font-extrabold mt-12 mb-4">सोशल मीडिया पर</h2>
    <ul class="grid gap-3 sm:grid-cols-3">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener" class="flex items-center gap-3 h-14 px-5 rounded-2xl bg-white/70 border border-ink/10 font-semibold">
            <Social name={s.key} />{s.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
