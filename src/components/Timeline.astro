---
import { timeline } from "../data/site";
---
<ol class="relative ml-7 border-l-2 border-saffron/40 space-y-6">
  {timeline.map((t) => (
    <li class="relative pl-8">
      <span
        class="absolute -left-8 top-0 grid place-items-center h-14 w-14 rounded-full bg-paper border-2 border-gold font-display font-bold text-base text-saffron-deep"
      >{t.year}</span>
      <p class="min-h-14 flex items-center text-lg leading-snug">{t.text}</p>
    </li>
  ))}
</ol>
