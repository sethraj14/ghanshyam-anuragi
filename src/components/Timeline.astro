---
import { timeline } from "../data/site";
const last = timeline.length - 1;
---
<ol class="rail stagger relative ml-7 border-l-2 border-saffron/25 space-y-6">
  {timeline.map((t, i) => (
    <li class="relative pl-8">
      <span
        class:list={[
          "absolute -left-8 top-0 grid place-items-center h-14 w-14 rounded-full font-display font-bold text-base",
          i === last ? "bg-saffron text-white ring-4 ring-saffron/25" : "bg-paper border-2 border-gold text-saffron-deep",
        ]}
      >{t.year}</span>
      <p class="min-h-14 flex items-center text-lg leading-snug">{t.text}</p>
    </li>
  ))}
</ol>
