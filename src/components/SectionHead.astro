---
import Icon from "./Icon.astro";
interface Props { title: string; href?: string; more?: string; icon?: "camera" | "play" | "news" | "food" | "flag" | "people" | "phone" }
const { title, href, more = "सभी देखें", icon } = Astro.props;
---
<div class="reveal flex items-center justify-between gap-4 mb-6">
  <h2 class="flex items-center gap-3 text-2xl sm:text-3xl font-extrabold">
    {icon && <span class="grid place-items-center h-10 w-10 rounded-full bg-saffron/15 text-saffron-deep"><Icon name={icon} /></span>}
    {title}
  </h2>
  {href && <a href={href} class="group inline-flex items-center gap-1 shrink-0 text-saffron-deep font-semibold text-base">{more}<Icon name="arrow" size={18} class="transition-transform group-hover:translate-x-1" /></a>}
</div>
