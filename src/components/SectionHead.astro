---
interface Props { title: string; href?: string; more?: string }
const { title, href, more = "सभी देखें" } = Astro.props;
---
<div class="flex items-baseline justify-between gap-4 mb-5">
  <h2 class="text-2xl sm:text-3xl font-extrabold">{title}</h2>
  {href && <a href={href} class="shrink-0 text-saffron-deep font-semibold text-base">{more}</a>}
</div>
